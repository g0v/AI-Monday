---
import { href } from '../lib/data';

interface Props { title?: string; description?: string; image?: string }
const { title, description = 'g0v 揪松團 AI Monday 與相關 AI 主題議程的場次、講題與影片紀錄。', image } = Astro.props;
const fullTitle = title ? `${title}｜AI Monday` : 'AI Monday 講題紀錄';
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href('/')}><span class="mark">AI</span>Monday 講題紀錄</a>
        <a class="nav-link" href="https://data.civictech.tw/">開放資料</a>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>資料由 <a href="https://jothon.g0v.tw">g0v 揪松團</a> 維護，每天同步一次。影片授權依各講題標示。</p>
        <p>
          場次與講題資料可直接取用：
          <a href="https://data.civictech.tw/v0/aimonday/events.json">events.json</a>、<a href="https://data.civictech.tw/v0/aimonday/talks.json">talks.json</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * 一個強調色（鈷藍）＋冷灰中性色。圓角規則：容器 16px、內部元件 10px、標籤 6px。
   */
  :root {
    --bg: #f6f6f7;
    --surface: #ffffff;
    --surface-2: #eeeef1;
    --text: #18181b;
    --muted: #5d5d68;
    --line: #e1e1e6;
    --accent: #2f55d4;
    --accent-soft: #e7ecfc;
    --shadow: 0 1px 2px rgb(24 30 60 / .05), 0 8px 24px -12px rgb(24 30 60 / .18);
    --r-lg: 16px;
    --r-md: 10px;
    --r-sm: 6px;
    --font: 'Geist', 'Noto Sans TC', system-ui, -apple-system, 'PingFang TC', 'Microsoft JhengHei', sans-serif;
    --mono: 'Geist Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e0e11;
      --surface: #16161a;
      --surface-2: #1f1f25;
      --text: #ececf0;
      --muted: #a0a0ac;
      --line: #2a2a32;
      --accent: #8ea6ff;
      --accent-soft: #1b2341;
      --shadow: 0 1px 2px rgb(0 0 0 / .3), 0 12px 32px -16px rgb(0 0 0 / .6);
      color-scheme: dark;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  img { display: block; max-width: 100%; }
  /* 元件常設 display:grid/flex，會蓋過 hidden 屬性；搜尋篩選靠 hidden，所以要明確壓過 */
  [hidden] { display: none !important; }

  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; transition: color .2s, text-decoration-color .2s; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-sm); }

  h1, h2, h3 { line-height: 1.3; margin: 0; font-weight: 700; text-wrap: balance; }
  h1 { font-size: clamp(1.75rem, 4.2vw, 2.75rem); letter-spacing: -.02em; }
  h2 { font-size: 1.35rem; letter-spacing: -.01em; }
  h3 { font-size: 1.05rem; font-weight: 600; }
  p { text-wrap: pretty; }

  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 768px) { .wrap { padding: 0 32px; } }

  .skip { position: absolute; left: 16px; top: -48px; background: var(--accent); color: #fff; padding: 8px 12px; border-radius: var(--r-sm); z-index: 10; }
  .skip:focus { top: 8px; }

  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .site-header .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); text-decoration: none; letter-spacing: -.01em; }
  .brand .mark { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: var(--r-sm); background: var(--accent); color: #fff; font: 600 .8rem/1 var(--mono); }
  .nav-link { color: var(--muted); text-decoration: none; font-size: .9rem; }
  .nav-link:hover { color: var(--text); }

  main { padding-top: 40px; padding-bottom: 80px; }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: .875rem; padding: 24px 0 40px; }
  .site-footer p { margin: 4px 0; }
  .site-footer a { color: var(--muted); }
  .site-footer a:hover { color: var(--text); }

  /* 共用小元件 */
  .muted { color: var(--muted); }
  .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  /* 數字＋中文單位（25 分鐘）用這個：等寬字體沒有中文，會退回別的字體、字距不齊 */
  .num { font-variant-numeric: tabular-nums; }
  /* 內頁標題比首頁小一級 */
  .page-title { font-size: clamp(1.6rem, 3.2vw, 2.25rem); }
  .badge {
    display: inline-flex; align-items: center; gap: 4px; padding: 1px 7px; border-radius: var(--r-sm);
    background: var(--surface-2); color: var(--muted); font-size: .75rem; font-weight: 500; line-height: 1.6; white-space: nowrap;
  }
  .badge.accent { background: var(--accent-soft); color: var(--accent); }
  .back { display: inline-flex; gap: 6px; color: var(--muted); text-decoration: none; font-size: .9rem; margin-bottom: 20px; }
  .back:hover { color: var(--text); }
  .panel { background: var(--surface); border-radius: var(--r-lg); box-shadow: var(--shadow); }

  /* 影片縮圖：YouTube 的 hqdefault 是 4:3 加黑邊，裁成 16:9 */
  .thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--r-md); background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  a:hover .thumb img { transform: scale(1.03); }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
  }
</style>
