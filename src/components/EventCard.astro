---
import { eventTitle, formatDate, hasContent, href, speakerNames, talkTitle, type Event, type Talk } from '../lib/data';

interface Props { event: Event; talks: Talk[] }
const { event: e, talks } = Astro.props;
const shown = talks.filter(hasContent);
const openSlots = talks.length - shown.length;
const norm = (s: string) => s.toLowerCase();
const eventText = norm([eventTitle(e), e.venue, e.sponsor].filter(Boolean).join(' '));
const talkText = (t: Talk) =>
  norm([talkTitle(t), t.description, ...t.speakers.flatMap((s) => [s.name, s.affiliation]), ...t.keywords].filter(Boolean).join(' '));
---
<article class="card event-card" data-series={e.series} data-search={eventText}>
  <div class="meta">
    <time datetime={e.date}>{formatDate(e)}</time>
    {e.start_time && <span>{e.start_time}</span>}
    <span class="chip">{e.series}</span>
    {e.format && <span class="chip">{e.format}</span>}
    {e.status === '停辦' && <span class="chip accent">停辦</span>}
  </div>
  <h3><a href={href(`/events/${e.id}/`)}>{e.theme ?? e.series}</a></h3>
  {shown.length > 0 && (
    <ul class="talks">
      {shown.map((t) => (
        <li data-search={talkText(t)}>
          {t.kind === 'qa' ? (
            <span class="muted">QA</span>
          ) : (
            <a href={href(`/talks/${t.id}/`)}>{talkTitle(t)}</a>
          )}
          {t.speakers.length > 0 && <span class="muted">— {speakerNames(t)}</span>}
          {t.video?.youtube_id && <span class="chip" title="有影片">▶ 影片</span>}
        </li>
      ))}
    </ul>
  )}
  {openSlots > 0 && <p class="muted slots">還有 {openSlots} 個講者在邀約中</p>}
</article>

<style>
  h3 { font-size: 1.05rem; margin: 6px 0 4px; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .talks { margin: 4px 0 0; padding-left: 1.1em; }
  .talks li { margin: 2px 0; }
  .talks .muted { margin-left: .3em; }
  .talks .chip { margin-left: .4em; }
  .slots { margin: 4px 0 0; font-size: .875rem; }
</style>
