---
import Base from '../../layouts/Base.astro';
import { eventTitle, formatDate, getData, hasContent, href, rundown, speakerNames, talkTitle, thumbUrl, timeRange, today } from '../../lib/data';

export async function getStaticPaths() {
  const { events } = await getData();
  return events.map((e) => ({ params: { id: e.id }, props: { id: e.id } }));
}

const { events, talks } = await getData();
const e = events.find((x) => x.id === Astro.props.id)!;
const own = talks.filter((t) => t.event_id === e.id).sort((a, b) => a.order - b.order);
const rows = rundown(e, own);
const isPast = e.date < today;
const i = events.indexOf(e);
const prev = events.slice(0, i).reverse().find((x) => x.series === e.series);
const next = events.slice(i + 1).find((x) => x.series === e.series);
const description = `${formatDate(e)} ${eventTitle(e)}。${own.filter(hasContent).map(talkTitle).join('、')}`;
const cover = own.map(thumbUrl).find(Boolean) ?? undefined;
const facts = [
  ['日期', formatDate(e)],
  ['時間', timeRange(e)],
  ['形式', e.format],
  ['地點', e.venue],
  ['贊助', e.sponsor],
].filter(([, v]) => v) as [string, string][];
---
<Base title={eventTitle(e)} description={description} image={cover}>
  <a class="back" href={href('/')}>← 全部場次</a>

  <header class="head">
    <div class="meta">
      <span class="badge">{e.series}</span>
      {e.status && <span class={`badge${e.status === '停辦' ? ' accent' : ''}`}>{e.status}</span>}
    </div>
    <h1 class="page-title">{e.theme ?? `${e.series} ${formatDate(e)}`}</h1>
  </header>

  <dl class="facts">
    {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
    {e.notes_url && (<div class="wide"><dt>共筆</dt><dd><a href={e.notes_url}>{e.notes_url}</a></dd></div>)}
  </dl>

  <section class="agenda">
    <h2>{isPast ? '議程' : '預定議程'}</h2>
    {own.length === 0 ? (
      <p class="muted">議程還沒排定。</p>
    ) : (
      <ol class="timeline">
        {rows.map(({ talk: t, at }) => {
          const thumb = thumbUrl(t);
          return (
            <li class={t.open_slot ? 'slot' : ''}>
              <span class="at mono">{at ?? ''}</span>
              <div class="item">
                <div class="text">
                  {t.open_slot ? (
                    <span class="muted">講者邀約中</span>
                  ) : t.kind === 'qa' ? (
                    <a class="title" href={href(`/talks/${t.id}/`)}>QA</a>
                  ) : (
                    <a class="title" href={href(`/talks/${t.id}/`)}>{talkTitle(t)}</a>
                  )}
                  {t.speakers.length > 0 && <div class="who">{speakerNames(t)}</div>}
                  <div class="tags">
                    {t.duration_min && <span class="muted num">{t.duration_min} 分鐘</span>}
                    {t.video?.youtube_id && <span class="badge">影片</span>}
                    {t.slides_url && <span class="badge">簡報</span>}
                  </div>
                </div>
                {thumb && (
                  <a class="mini" href={href(`/talks/${t.id}/`)} tabindex="-1" aria-hidden="true">
                    <div class="thumb"><img src={thumb} alt="" loading="lazy" width="320" height="180" /></div>
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    )}
  </section>

  {e.promotions.length > 0 && (
    <section class="promos">
      <h2>宣傳事項</h2>
      <ul>
        {e.promotions.map((p) => {
          // 把文字裡的網址變成連結；其他照原文
          const parts = p.text.split(/(https?:\/\/\S+)/);
          return <li>{parts.map((s) => (/^https?:\/\//.test(s) ? <a href={s}>{s}</a> : s))}</li>;
        })}
      </ul>
    </section>
  )}

  <nav class="pager" aria-label={`其他 ${e.series} 場次`}>
    {prev ? (
      <a href={href(`/events/${prev.id}/`)}><span class="muted">上一場 {e.series}</span><span>{prev.theme ?? formatDate(prev)}</span></a>
    ) : <span />}
    {next && (
      <a class="to-next" href={href(`/events/${next.id}/`)}><span class="muted">下一場 {e.series}</span><span>{next.theme ?? formatDate(next)}</span></a>
    )}
  </nav>
</Base>

<style>
  .head { max-width: 56rem; }
  .meta { display: flex; gap: 6px; margin-bottom: 12px; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 20px 32px; margin: 32px 0 48px; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts dt { font-size: .8rem; color: var(--muted); }
  .facts dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  .facts .wide { grid-column: 1 / -1; }

  .agenda h2, .promos h2 { margin-bottom: 20px; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 16px; position: relative; }
  @media (min-width: 768px) { .timeline li { grid-template-columns: 5rem 1fr; gap: 24px; } }
  .at { color: var(--muted); font-size: .9rem; padding-top: 18px; }
  .item {
    display: grid; gap: 16px; padding: 16px 0 20px; border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) { .item { grid-template-columns: 1fr 10rem; align-items: start; } }
  .title { font-size: 1.05rem; font-weight: 600; color: var(--text); text-decoration: none; }
  .title:hover { color: var(--accent); }
  .who { margin-top: 2px; color: var(--muted); font-size: .9rem; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 8px; font-size: .85rem; }
  .tags:empty { display: none; }
  .slot .item { color: var(--muted); }
  .mini { display: block; }

  .promos { margin-top: 56px; max-width: 48rem; }
  .promos ul { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; }
  .promos li { white-space: pre-line; overflow-wrap: anywhere; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: 2px; color: var(--text); text-decoration: none; font-weight: 500; }
  .pager a .muted { font-size: .8rem; font-weight: 400; }
  .pager a:hover span:last-child { color: var(--accent); }
  .pager .to-next { text-align: right; grid-column: 2; }
</style>
